#!/usr/bin/env bash
# Test stub for `gh api [--paginate] <path> [--jq <expr>]` and
# `gh release download <tag> -R <repo> -p <pattern> -O <file> [--clobber]`.
# `release download` copies "$FIX/asset" to <file> and logs
# "release download <tag> <repo> <pattern>". `api` serves "$FIX/pr.json" for repos/*/pulls/<n>, "$FIX/files.json" for
# repos/*/pulls/<n>/files and "$FIX/compare.json" for
# repos/*/dependency-graph/compare/<base>...<head>, and applies --jq the way gh
# does (strings raw). Every call is logged to "$FIX/calls".
# With FAIL_ONCE=1 the first call for each path (or the first download) fails
# the way a transient error does: `api` with gh's "HTTP 502" message,
# `release download` with a broken connection.
set -euo pipefail
# fail_once <key> <message>: fails the first call for <key> in this fixture.
fail_once() {
  local mark
  mark="$FIX/failed-$(printf '%s' "$1" | sha256sum | cut -c1-16)"
  if [ "${FAIL_ONCE:-}" = 1 ] && [ ! -e "$mark" ]; then
    : > "$mark"
    echo "$2" >&2
    exit 1
  fi
}
if [ "${1-}" = release ] && [ "${2-}" = download ]; then
  tag=$3 repo="" pattern="" out=""
  shift 3
  while [ $# -gt 0 ]; do
    case "$1" in
      -R) repo=$2; shift ;;
      -p) pattern=$2; shift ;;
      -O) out=$2; shift ;;
      --clobber) ;;
      *) echo "gh stub: unexpected release download argument: $1" >&2; exit 2 ;;
    esac
    shift
  done
  printf 'release download %s %s %s\n' "$tag" "$repo" "$pattern" >> "$FIX/calls"
  fail_once "release download" "read tcp: connection reset by peer"
  cp "$FIX/asset" "$out"
  exit 0
fi
path=""
expr=""
while [ $# -gt 0 ]; do
  case "$1" in
    api | --paginate) ;;
    --jq) expr="$2"; shift ;;
    *) path="$1" ;;
  esac
  shift
done
printf '%s\n' "$path" >> "$FIX/calls"
fail_once "api $path" "gh: Server Error (HTTP 502)"
case "$path" in
  repos/*/dependency-graph/compare/*...*) file="$FIX/compare.json" ;;
  repos/*/pulls/*/files) file="$FIX/files.json" ;;
  repos/*/pulls/*) file="$FIX/pr.json" ;;
  *) echo "gh stub: unexpected call: $path" >&2; exit 2 ;;
esac
if [ -n "$expr" ]; then
  jq -r "$expr" "$file"
else
  cat "$file"
fi
